{
  "name": "@town-map/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./migrations": {
      "types": "./src/migrations.ts",
      "import": "./dist/migrations.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/migrate.ts src/migrations.ts --format esm --dts",
    "check": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@town-map/contracts": "workspace:*",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.1",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
