{
  "name": "@town-map/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts --format esm --sourcemap",
    "check": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clerk/fastify": "^3.1.59",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@town-map/contracts": "workspace:*",
    "@town-map/db": "workspace:*",
    "fastify": "5.11.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
