# Shared Railway database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/town_map

# API
PORT=3001
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Vite/Capacitor client
VITE_API_URL=http://localhost:3001
VITE_DEMO_MODE=true

# Collectors
DRY_RUN=false
MAGIC_SEARCH_CENTERS_JSON=[{"name":"Chicago","latitude":41.8781,"longitude":-87.6298,"radiusMeters":100000}]
YUGIOH_STATES=IL
YUGIOH_LOOKAHEAD_DAYS=90
# Leave blank for worldwide coverage, or use comma-separated ISO country codes.
POKEMON_COUNTRIES=
COLLECTOR_REGION_CADENCE_MINUTES=360
COLLECTOR_JOB_LIMIT=8
COLLECTOR_LEASE_MINUTES=30
COLLECTOR_RETRY_MINUTES=30
POKEDATA_TIMEOUT_MS=120000
