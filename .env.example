# Shared Railway database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/town_map

# Connection pool. One PostgreSQL instance is shared by every API replica and all
# five collectors, so keep the sum of DATABASE_POOL_MAX below the server limit.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# API
PORT=3001
# Aborts a runaway query rather than holding a request open. Left unset for
# collectors and always disabled for migrations, whose work legitimately runs long.
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Grace period for in-flight requests to finish after SIGTERM.
SHUTDOWN_TIMEOUT_MS=15000
# Counted per process, so the real ceiling is this times the replica count.
# /health is always exempt. Use the plugin's Redis store for an exact limit.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# Tighter ceiling for the endpoint that reaches the upstream geocoder.
RATE_LIMIT_GEOCODE_MAX=20
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=TownMap/1.0 (https://town-map-eight.vercel.app)

# Vite/Capacitor client
VITE_API_URL=http://localhost:3001
VITE_DEMO_MODE=true
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key

# Collectors
DRY_RUN=false
# Optional override of the catalog in services/ingest-magic/src/centers.ts.
# Validated on load: a center needs name, latitude, longitude, and radiusMeters.
# MAGIC_SEARCH_CENTERS_JSON=[{"name":"Chicago","latitude":41.8781,"longitude":-87.6298,"radiusMeters":100000}]
# Optional override of the catalog in services/ingest-yugioh/src/states.ts.
# Validated on load: every code must be a US state or DC.
# YUGIOH_STATES=IL
YUGIOH_LOOKAHEAD_DAYS=90
# Bandai TCG+ region definitions use ISO country and subdivision codes.
ONEPIECE_REGIONS_JSON=[{"name":"United States — IL","countryCode":"US","prefCodes":["US-IL"]}]
ONEPIECE_LOOKAHEAD_DAYS=90
ONEPIECE_MAX_PAGES=100
# Riftbound locator coverage is defined by coordinate/radius circles.
RIFTBOUND_SEARCH_CENTERS_JSON=[{"name":"Chicago","countryCode":"US","latitude":41.8781,"longitude":-87.6298,"radiusMiles":100}]
RIFTBOUND_LOOKAHEAD_DAYS=180
RIFTBOUND_MAX_PAGES=20
# Leave blank for worldwide coverage, or use comma-separated ISO country codes.
POKEMON_COUNTRIES=
COLLECTOR_REGION_CADENCE_MINUTES=360
COLLECTOR_JOB_LIMIT=8
COLLECTOR_LEASE_MINUTES=30
COLLECTOR_RETRY_MINUTES=30
# Emergency stop for one collector service. Disabled regions remain visible in coverage reporting.
COLLECTOR_ENABLED=true
# Optional comma-separated region keys for staged rollouts. An empty value disables every region.
# COLLECTOR_REGION_ALLOWLIST=us-il-chicago
# Optional priority ceiling; lower numbers run first.
# COLLECTOR_MAX_REGION_PRIORITY=100
POKEDATA_TIMEOUT_MS=120000

# Maintenance
# Events that finished longer ago than this are deleted daily, along with their
# stored upstream payloads. Nothing reads past events.
EVENT_RETENTION_DAYS=365
